{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniFlow host invocation feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution", "observation", "task", "control"],
  "properties": {
    "schema_version": {"const": "omniflow.invocation.v1"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "function_id", "actions_executed", "next_step_index", "failed_step_index", "failed_action_dispatched", "error"],
      "properties": {
        "status": {"enum": ["completed", "yielded", "failed"]},
        "function_id": {"type": ["string", "null"]},
        "actions_executed": {"type": "integer", "minimum": 0},
        "next_step_index": {"type": ["integer", "null"], "minimum": 0},
        "failed_step_index": {"type": ["integer", "null"], "minimum": 0},
        "failed_action_dispatched": {"type": ["boolean", "null"]},
        "error": {"type": ["string", "null"]}
      }
    },
    "observation": {"type": ["object", "null"]},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"enum": ["unknown", "verified_success", "verified_incomplete", "verifier_error"]}}
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["next", "reason", "automatic_retry"],
      "properties": {
        "next": {"enum": ["host", "stop"]},
        "reason": {"type": "string", "minLength": 1},
        "automatic_retry": {"const": false}
      }
    }
  }
}
