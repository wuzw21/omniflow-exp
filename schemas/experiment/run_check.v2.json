{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/experiment/run_check.v2.json",
  "title": "OmniFlow run check report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ready", "paths", "target", "memory", "checks"],
  "properties": {
    "schema_version": {"const": "omniflow.run-check.v2"},
    "ready": {"type": "boolean"},
    "host": {"type": "string"},
    "platform": {"type": "string"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "code_root"],
      "properties": {
        "repo": {"type": "string"},
        "code_root": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serial", "profile"],
      "properties": {
        "serial": {"type": "string"},
        "profile": {"type": "string"}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "condition", "root", "fingerprint"],
      "properties": {
        "provider": {"enum": ["none", "appagent", "mobilegpt"]},
        "condition": {"enum": ["empty_memory", "prepared_memory"]},
        "root": {"type": "string"},
        "fingerprint": {"type": "string"}
      }
    },
    "checks": {"type": "array", "items": {"type": "object"}},
    "failure_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0}
  }
}
