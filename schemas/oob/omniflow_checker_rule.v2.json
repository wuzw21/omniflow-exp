{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/oob/omniflow_checker_rule.v2.json",
  "title": "OmniFlow Checker Rule",
  "description": "One Function-local RunLog source state and source action target-mapped before each pending Function action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_state_id", "action"],
  "properties": {
    "source_state_id": {"type": "string", "minLength": 1},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {
        "tool": {"type": "string", "enum": ["click", "input_text", "long_press"]},
        "args": {"type": "object"}
      }
    }
  }
}
