{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/oob/omniflow_function.v2.json",
  "title": "OmniFlow Function",
  "description": "The single reusable Function representation shared by OpenOmniBot and OmniFlow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "function_id",
    "name",
    "description",
    "input_schema",
    "bindings",
    "steps",
    "agent_visible"
  ],
  "properties": {
    "schema_version": {"const": "omniflow.function.v2"},
    "function_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1},
    "input_schema": {"$ref": "#/$defs/input_schema"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "agent_visible": {"type": "boolean"}
  },
  "$defs": {
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "additionalProperties": {"const": false}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"type": "string", "pattern": "^\\$\\.arguments(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])+$"},
        "target": {
          "type": "string",
          "pattern": "^\\$\\.steps\\[[0-9]+\\]\\.action\\.args(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])+$",
          "not": {
            "pattern": "^\\$\\.steps\\[[0-9]+\\]\\.action\\.args\\.(?:x|y|x1|y1|x2|y2)$"
          },
          "description": "Bind semantic action arguments only. Coordinates are immutable source transfer evidence and are never Function inputs."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "source_state_id", "action"],
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Function-local zero-based array position. Values MUST be contiguous 0..N-1 and MUST NOT copy source RunLog step indices."
        },
        "source_state_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the source observation used for transfer evidence; this is the only link back to the source RunLog."
        },
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "args": {"type": "object"}
      }
    }
  }
}
